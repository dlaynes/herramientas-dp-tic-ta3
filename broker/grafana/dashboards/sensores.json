{
  "uid": "iot-sensores-dht22",
  "title": "IoT - Sensores DHT22 simulados",
  "tags": [
    "iot",
    "mqtt",
    "emqx"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperatura actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-sensores"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-sensores"
          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mediciones\" and r._field == \"temperatura\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"ubicacion\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "displayName": "${__field.labels.ubicacion}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 22
              },
              {
                "color": "orange",
                "value": 27
              },
              {
                "color": "red",
                "value": 29
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "auto"
      }
    },
    {
