          },
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mediciones\" and r._field == \"presion\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"ubicacion\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa",
          "decimals": 1,
          "displayName": "${__field.labels.ubicacion}",
